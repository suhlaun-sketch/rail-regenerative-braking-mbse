          <ownedComment xmi:type="uml:Comment" xmi:id="XMI-COMMENT-ITEM-F73B0220FF24CD432C6CB003" body="item_code=ITM-ACC-004; 超级电容储能支路实际吸收的再生功率。" />
        </packagedElement>
        <packagedElement xmi:type="uml:Signal" xmi:id="XMI-ITEM-ITM-ACC-005" name="制动电阻耗散功率">
          <ownedComment xmi:type="uml:Comment" xmi:id="XMI-COMMENT-ITEM-3515D102F83B64634AAAA68A" body="item_code=ITM-ACC-005; 制动电阻实际耗散功率。" />
        </packagedElement>
        <packagedElement xmi:type="uml:Signal" xmi:id="XMI-ITEM-ITM-ACC-015" name="能量回收率">
          <ownedComment xmi:type="uml:Comment" xmi:id="XMI-COMMENT-ITEM-39600DB6A9AB24D8877C5C75" body="item_code=ITM-ACC-015; 按项目统一分母定义计算的有效再生能量回收比例。" />
        </packagedElement>
        <packagedElement xmi:type="uml:Signal" xmi:id="XMI-ITEM-ITM-CMD-001" name="列车方向指令">
          <ownedComment xmi:type="uml:Comment" xmi:id="XMI-COMMENT-ITEM-1ADB7F05A0C80BA241D2369A" body="item_code=ITM-CMD-001; 司机或控制系统给出的列车运行方向选择。" />
        </packagedElement>
        <packagedElement xmi:type="uml:Signal" xmi:id="XMI-ITEM-ITM-CMD-002" name="牵引指令">
          <ownedComment xmi:type="uml:Comment" xmi:id="XMI-COMMENT-ITEM-A35CB8900D046E9EA511B002" body="item_code=ITM-CMD-002; 司机/ATO等给出的归一化牵引需求。" />
        </packagedElement>
        <packagedElement xmi:type="uml:Signal" xmi:id="XMI-ITEM-ITM-CMD-003" name="服务制动请求">
          <ownedComment xmi:type="uml:Comment" xmi:id="XMI-COMMENT-ITEM-7BD1F26C68408D320A2B77E6" body="item_code=ITM-CMD-003; 服务制动需求;可采用归一化请求或减速度请求,工程中必须在接口处固定一种语义。" />
        </packagedElement>
        <packagedElement xmi:type="uml:Signal" xmi:id="XMI-ITEM-ITM-CMD-004" name="紧急制动请求">
          <ownedComment xmi:type="uml:Comment" xmi:id="XMI-COMMENT-ITEM-FA82CB74D39DB72C491FC7B8" body="item_code=ITM-CMD-004; 触发紧急制动的有效请求。" />
        </packagedElement>
        <packagedElement xmi:type="uml:Signal" xmi:id="XMI-ITEM-ITM-CMD-006" name="动态制动力请求">
          <ownedComment xmi:type="uml:Comment" xmi:id="XMI-COMMENT-ITEM-D9938DD553376BB288F6693E" body="item_code=ITM-CMD-006; 分配给牵引电制动通道的动态制动力请求。" />
        </packagedElement>
        <packagedElement xmi:type="uml:Signal" xmi:id="XMI-ITEM-ITM-CMD-008" name="牵引切除请求">
          <ownedComment xmi:type="uml:Comment" xmi:id="XMI-COMMENT-ITEM-718659F123D9AEB2C9355330" body="item_code=ITM-CMD-008; 制动或安全功能要求牵引系统禁止输出牵引力的请求。" />
        </packagedElement>
        <packagedElement xmi:type="uml:Signal" xmi:id="XMI-ITEM-ITM-CMD-009" name="牵引使能指令">
