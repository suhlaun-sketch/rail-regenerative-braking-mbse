        </packagedElement>
        <packagedElement xmi:type="uml:Signal" xmi:id="XMI-ITEM-ITM-ACC-003" name="回馈电网功率">
          <ownedComment xmi:type="uml:Comment" xmi:id="XMI-COMMENT-ITEM-C5C416CC389263E0D2E7ABB9" body="item_code=ITM-ACC-003; 实际回馈至外部供电网络的电功率。" />
        </packagedElement>
